# Database (Defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./coolshield.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://coolshield:change_this_password@localhost:5432/coolshield

# Secret & API Keys
INGEST_API_KEY=local-demo-key-change-me

# Dubai Operational Localization Defaults
TIMEZONE=Asia/Dubai
DEFAULT_CURRENCY=AED
DEFAULT_LANGUAGE=en

# Optional External Integrations
MQTT_BROKER=localhost
MQTT_PORT=1883
