# ==============================================================================
# CoolShield AI — Environment Configuration Template
# All secrets must be set in Vercel Project Settings > Environment Variables.
# NEVER commit real production credentials or API keys to source control.
# ==============================================================================

# Application Environment & Logging
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Frontend Public API Base URL
# Leave empty for pure static SPA in-memory mock mode on Vercel,
# or set to your deployed FastAPI backend (e.g., https://api.yourdomain.com/api/v1)
VITE_API_URL=

# Backend & Persistence (FastAPI & PostgreSQL)
# Required when running with persistent backend storage (Neon, Supabase, Railway)
DATABASE_URL=postgresql://coolshield_user:CHANGE_ME_IN_PRODUCTION@ep-dubai-db.neon.tech/coolshield_db?sslmode=require

# Security & RBAC Authentication
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SHA256_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=https://dubai-ai-agent.vercel.app,http://localhost:5173

# n8n Visual Workflow Automation Engine
# URL and API Key for autonomous agent triggers and event-driven webhooks
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook
N8N_API_KEY=n8n_sec_CHANGE_ME_SECRET_KEY

# Optional AI / LLM Provider Gateways
OPENAI_API_KEY=sk-proj-PLACEHOLDER_KEY
GEMINI_API_KEY=AIzaSyPLACEHOLDER_KEY

# Dubai Smart City External Gateways (Mocks & Simulators)
DEWA_API_BASE=https://api.dewa.gov.ae/v1/smartmeter/sandbox
NCM_WEATHER_API_BASE=https://api.ncm.ae/v2/live
